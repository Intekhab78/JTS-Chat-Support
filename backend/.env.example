# ==============================================================================
# JTS CHAT SUPPORT & CRM MASTER CONFIGURATION
# ==============================================================================

# Core Database & Security (REQUIRED)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/chat-support
JWT_SECRET=replace_with_a_long_random_64_character_hex_string
CLIENT_URL=http://localhost:5173
WIDGET_PUBLIC_URL=https://chatapi.jtsmiddleeast.com/chat-widget.js
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://chat.jtsmiddleeast.com,https://chatapi.jtsmiddleeast.com

# Email Notification Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="JTS Support" <your_email@gmail.com>

# SLA Alert Thresholds
SLA_QUEUE_ALERT_MINUTES=5
SLA_TICKET_ALERT_HOURS=24

# Payment Gateway (Razorpay & Stripe)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_BASIC_PRICE_ID=price_xxxx
STRIPE_STANDARD_PRICE_ID=price_xxxx
STRIPE_PRO_PRICE_ID=price_xxxx

# AI Intelligence
GEMINI_API_KEY=your_gemini_api_key

# ==============================================================================
# THIRD-PARTY INTEGRATION CHANNELS & PROVIDERS
# ==============================================================================

# 1. WhatsApp Cloud API (Meta Developer Portal)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=109283746192834
WHATSAPP_BUSINESS_ACCOUNT_ID=987123654129384
WHATSAPP_WEBHOOK_VERIFY_TOKEN=jts_whatsapp_secure_webhook_verify_2026

# 2. Twilio SMS Gateway (Twilio Console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# 3. Telegram Bot API (Telegram @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=JTSChatSupportBot

# 4. Google Calendar API (Google Cloud Console OAuth 2.0)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# 5. Microsoft Outlook Calendar (Azure / Entra ID App Registration)
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=xxxx~xxxx

# 6. AI Document OCR & Cloud Vision
GOOGLE_VISION_API_KEY=AIzaSy...
