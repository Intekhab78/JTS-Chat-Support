# Dashboard environment variables
# By default, local development tries http://localhost:5000 first and falls back
# to the deployed backend below when the local backend is not running.
VITE_REMOTE_API_URL=https://chatapi.jtsonline.shop
# VITE_LOCAL_API_URL=http://localhost:5000

# Optional hard override. Use only when you want to force one API URL and skip
# local/remote auto-detection.
# VITE_API_URL=https://chatapi.jtsonline.shop
